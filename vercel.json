{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/frontend/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/servicos/",
      "destination": "/servicos",
      "permanent": true
    },
    {
      "source": "/projetos/",
      "destination": "/projetos",
      "permanent": true
    },
    {
      "source": "/projetos/m2r-server/",
      "destination": "/projetos/m2r-server",
      "permanent": true
    },
    {
      "source": "/blog/",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/sobre/",
      "destination": "/sobre",
      "permanent": true
    },
    {
      "source": "/contato/",
      "destination": "/contato",
      "permanent": true
    },
    {
      "source": "/pages/servicos.html",
      "destination": "/servicos",
      "permanent": true
    },
    {
      "source": "/pages/projetos.html",
      "destination": "/projetos",
      "permanent": true
    },
    {
      "source": "/pages/projetos/m2r-server.html",
      "destination": "/projetos/m2r-server",
      "permanent": true
    },
    {
      "source": "/pages/blog.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/pages/sobre.html",
      "destination": "/sobre",
      "permanent": true
    },
    {
      "source": "/pages/contato.html",
      "destination": "/contato",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/servicos",
      "destination": "/frontend/pages/servicos.html"
    },
    {
      "source": "/projetos",
      "destination": "/frontend/pages/projetos.html"
    },
    {
      "source": "/projetos/m2r-server",
      "destination": "/frontend/pages/projetos/m2r-server.html"
    },
    {
      "source": "/blog",
      "destination": "/frontend/pages/blog.html"
    },
    {
      "source": "/sobre",
      "destination": "/frontend/pages/sobre.html"
    },
    {
      "source": "/contato",
      "destination": "/frontend/pages/contato.html"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/frontend/assets/$1"
    },
    {
      "source": "/robots.txt",
      "destination": "/frontend/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/frontend/sitemap.xml"
    },
    {
      "source": "/404",
      "destination": "/frontend/404.html"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/404.html"
    }
  ]
}
