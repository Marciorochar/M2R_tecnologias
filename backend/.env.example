# Local development defaults. Production must use HTTPS and shared rate-limit storage.
FRONTEND_URL=https://m2rtecnologias.vercel.app
APP_ENV=development
RATELIMIT_STORAGE_URI=memory://
# Defina 1 somente quando houver exatamente um proxy reverso confiavel na frente do Flask.
TRUSTED_PROXY_HOPS=0

# Production example (configure the real managed Redis URL in the hosting platform):
# APP_ENV=production
# RATELIMIT_STORAGE_URI=rediss://user:password@redis.example:6379/0
# TRUSTED_PROXY_HOPS=1
